{
  "schema_version": "1.1",
  "runtime": {
    "language": "Python",
    "minimum_version": "3.11",
    "third_party_runtime_dependencies": [
      {
        "name": "psutil",
        "version": ">=5.9,<8",
        "purpose": "read-only system connection and process metadata"
      }
    ]
  },
  "entrypoints": [
    "infa-sled",
    "python src/main.py",
    "infa-sled-monitor",
    "python src/system_monitor.py"
  ],
  "storage": {
    "database": null,
    "output_pattern": "report/<source>-<language>__<readable-utc-timestamp>__sha256-<8-char-prefix>/",
    "automatic_retention": false,
    "atomic_writes": true,
    "presentation_modes": ["files", "terminal", "both"],
    "file_formats": ["json", "pdf", "jsonl"],
    "monitor_output_pattern": "report/system-connections__<readable-utc-timestamp>__<system>/connections.jsonl"
  },
  "system_monitor": {
    "supported_operating_systems": ["windows", "linux"],
    "connection_kinds": ["tcp", "udp", "ipv4", "ipv6"],
    "default_duration_seconds": 30,
    "default_interval_seconds": 1,
    "historical_event_log_import": false,
    "packet_capture": false,
    "modifies_connections": false
  },
  "network_integrations": [
    {
      "name": "NTP",
      "default_enabled": false,
      "protocol": "UDP/123",
      "sends_script": false
    },
    {
      "name": "VirusTotal API v3",
      "default_enabled": false,
      "protocol": "HTTPS",
      "host": "www.virustotal.com",
      "secret_header": "x-apikey",
      "sends": "IOC only"
    },
    {
      "name": "URLhaus API v1",
      "default_enabled": false,
      "protocol": "HTTPS",
      "host": "urlhaus-api.abuse.ch",
      "secret_header": "Auth-Key",
      "sends": "IOC only"
    }
  ],
  "limits": {
    "script_bytes": 5000000,
    "connection_log_bytes": 10000000,
    "connection_log_lines": 100000,
    "reputation_response_bytes": 1000000,
    "default_network_timeout_seconds": 5,
    "monitor_duration_seconds": 86400,
    "monitor_interval_min_seconds": 0.1,
    "monitor_interval_max_seconds": 60,
    "monitor_events_per_session": 100000
  },
  "ci": {
    "provider": "GitHub Actions",
    "operating_systems": ["ubuntu-latest", "windows-latest"],
    "python_versions": ["3.11", "3.12"],
    "network_features_in_tests": false
  }
}
