{
  "schema_version": "1.5",
  "runtime": {
    "language": "Python",
    "minimum_version": "3.11",
    "third_party_runtime_dependencies": [],
    "optional_static_analysis_extra": ["esprima==4.0.1", "semgrep>=1.186,<2", "yara-python>=4.5,<5"]
  },
  "entrypoints": [
    "infa-sled",
    "python src/main.py"
  ],
  "windows_installer": {
    "entrypoint": "install.cmd",
    "prerequisites": ["Windows x64", "py launcher", "Windows PowerShell"],
    "python_extra": "static-analysis",
    "shellcheck_version": "0.11.0",
    "shellcheck_location": "%LOCALAPPDATA%\\Programs\\ShellCheck",
    "path_scope": "user"
  },
  "storage": {
    "database": null,
    "output_pattern": "raport/<source>-<language>__<readable-utc-timestamp>__sha256-<8-char-prefix>/",
    "report_filenames": ["raport.json", "raport.pdf"],
    "automatic_retention": false,
    "atomic_writes": true,
    "presentation_modes": ["terminal-default", "raport"],
    "report_type_values": ["json", "pdf", "all"],
    "default_presentation": "terminal",
    "report_type_default": "all",
    "file_formats": ["json", "pdf"]
  },
  "connection_correlation": {
    "input_formats": ["text", "csv", "jsonl", "windows-event-xml", "linux-audit"],
    "automatic_system_log_collection": false,
    "opt_in_system_flag": "--system-history",
    "statuses": ["confirmed", "request-observed", "allowed", "blocked", "dns-only", "host-only", "mentioned-only", "not-observed", "not-checked"]
  },
  "historical_evidence": {
    "result_schema_version": "1.3",
    "windows": {"tool": "wevtutil qe", "sysmon_event_ids": [1, 3, 22], "security_event_ids": [4688, 5156, 5157]},
    "linux": {"tool": "journalctl --system -o json", "audit_file": "/var/log/audit/audit.log", "supported": ["outbound-ufw", "audit-execve", "sysmon-xml-in-message"]},
    "execution_identity": ["exact-script-path", "explicit-script-sha256"],
    "process_correlation": ["host", "ProcessGuid"],
    "execution_statuses": ["confirmed", "not-observed", "not-checked"],
    "continuous_monitor": false,
    "changes_audit_configuration": false,
    "subprocess_shell": false
  },
  "static_analysis": {
    "result_field": "engine_runs",
    "engines_by_language": {
      "bash": ["yara", "semgrep", "shellcheck"],
      "javascript": ["yara", "semgrep", "esprima"],
      "powershell": ["yara", "powershell-parser"]
    },
    "system_tools": ["shellcheck", "pwsh or powershell.exe"],
    "representations": ["original", "deobfuscated"],
    "statuses": ["ok", "partial", "unavailable", "skipped", "error"],
    "uses_remote_rules": false,
    "subprocess_shell": false
  },
  "network_integrations": [
    {
      "name": "NTP",
      "default_enabled": false,
      "protocol": "UDP/123",
      "sends_script": false
    },
    {
      "name": "VirusTotal API v3",
      "default_enabled": false,
      "protocol": "HTTPS",
      "host": "www.virustotal.com",
      "secret_header": "x-apikey",
      "sends": "IOC only"
    },
    {
      "name": "URLhaus API v1",
      "default_enabled": false,
      "protocol": "HTTPS",
      "host": "urlhaus-api.abuse.ch",
      "secret_header": "Auth-Key",
      "sends": "IOC only"
    }
  ],
  "limits": {
    "script_bytes": 5000000,
    "connection_log_bytes": 10000000,
    "connection_log_lines": 100000,
    "reputation_response_bytes": 1000000,
    "default_network_timeout_seconds": 5,
    "history_command_timeout_seconds": 10,
    "history_stdout_bytes": 10000000,
    "history_stderr_bytes": 65536,
    "history_default_hours": 24,
    "history_default_max_events": 1000,
    "static_engine_input_bytes": 5000000,
    "static_engine_timeout_seconds": 15,
    "static_engine_stdout_bytes": 2000000,
    "static_engine_stderr_bytes": 65536,
    "static_engine_max_findings": 500
  },
  "ci": {
    "provider": "GitHub Actions",
    "operating_systems": ["ubuntu-latest", "windows-latest"],
    "python_versions": ["3.11", "3.12"],
    "network_features_in_tests": false,
    "installed_static_engine_test_os": "ubuntu-latest"
  }
}
